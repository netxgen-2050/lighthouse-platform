# Copiar a .env.local (ignorado por git). Nunca commitear valores reales.
# Vercel → Project → Settings → Deployment Protection → Protection Bypass for Automation
VERCEL_AUTOMATION_BYPASS_SECRET=

# Base de datos (Neon Postgres). La crea la integración de Neon en Vercel.
# Vacía en local: usa PGlite (Postgres embebido, sin red, con las migraciones aplicadas al arrancar).
# No pegues acá la URL de producción: apuntaría tu máquina a la base real (ver docs/guiones/neon-previews.md).
# DATABASE_URL=
# Conexión sin pool (la integración la crea); si existe, las migraciones del build la usan.
# DATABASE_URL_UNPOOLED=

# Login (Privy). El app id es público; el secreto solo vive en el servidor.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Carga inicial de la tabla `personas`: solo se usa si la tabla está vacía; después manda la base (panel "Personas y roles" en /netx).
# Formato email=rol:perfil separados por ";" (roles: superadmin = ve NetX y tiene acceso a todo; admin-tribu = líder de Valle Solar de antemano;
# persona; perfiles: usuario, inversor, comunidad). El nivel de cada persona sale de lo que elige en Sumarte.
# En Preview: solo emails .test o vacía. Ejemplo con emails inventados: super@ejemplo.test=superadmin:usuario;ana@ejemplo.test=admin-tribu:inversor
LH_PERSONAS=
# "lista" = vuelve la lista cerrada: solo entran las personas que ya están en la tabla. Vacío = acceso abierto.
LH_ACCESO=
# 1 = "Entrar como…" en Sumarte sin Privy. Solo Preview y Development: en Production el código lo ignora.
# Solo acepta emails que terminan en .test.
LH_AUTH_PRUEBA=
