# Copiar a .env.local (ignorado por git). Nunca commitear valores reales.
# Vercel → Project → Settings → Deployment Protection → Protection Bypass for Automation
VERCEL_AUTOMATION_BYPASS_SECRET=

# Login (Privy). El app id es público; el secreto solo vive en el servidor.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Lista de acceso y roles: email=rol:perfil separados por ";" (roles: superadmin, admin-tribu, persona; perfiles: usuario, inversor, comunidad).
# Ejemplo con emails inventados: super@ejemplo.test=superadmin:usuario;ana@ejemplo.test=admin-tribu:inversor
LH_PERSONAS=
# 1 = pantalla de entrada con "Entrar como…" sin Privy. Solo Preview y Development: en Production el código lo ignora.
LH_AUTH_PRUEBA=
