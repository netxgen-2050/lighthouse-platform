# Copiar a .env.local (ignorado por git). Nunca commitear valores reales.
# Vercel → Project → Settings → Deployment Protection → Protection Bypass for Automation
VERCEL_AUTOMATION_BYPASS_SECRET=

# Base de datos (Neon Postgres). La crea la integración de Neon en Vercel.
# Vacía en local: usa PGlite (Postgres embebido, sin red, con las migraciones aplicadas al arrancar).
# No pegues acá la URL de producción: apuntaría tu máquina a la base real (ver docs/guiones/neon-previews.md).
# DATABASE_URL=
# Conexión sin pool (la integración la crea); si existe, las migraciones del build la usan.
# DATABASE_URL_UNPOOLED=

# Login (Privy). El app id es público; el secreto solo vive en el servidor.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Login con Neon Auth (login-neon-auth): código por email y Google. Qué login abre el paso de consentimiento: "privy" (por
# defecto) o "neon-auth". Se cambia primero en Preview y recién después en Production (docs/guiones/login-neon-auth.md).
# NEXT_PUBLIC_LH_LOGIN=privy
# URL del Auth de la rama de Neon (la integración de Vercel la puede inyectar en cada preview; a verificar).
# NEON_AUTH_BASE_URL=
# Secreto propio (32 caracteres o más) que firma las cookies de sesión; uno distinto para Production y Preview.
# NEON_AUTH_COOKIE_SECRET=
# Carga inicial de la tabla `personas`: solo se usa si la tabla está vacía; después manda la base (panel "Personas y roles" en /netx).
# Formato email=rol:perfil separados por ";" (roles: superadmin = ve NetX y tiene acceso a todo; admin-tribu = líder de Valle Solar de antemano;
# persona; perfiles: usuario, inversor, comunidad). El nivel de cada persona sale de lo que elige en Sumarte.
# En Preview: solo emails .test o vacía. Ejemplo con emails inventados: super@ejemplo.test=superadmin:usuario;ana@ejemplo.test=admin-tribu:inversor
LH_PERSONAS=
# "lista" = vuelve la lista cerrada: solo entran las personas que ya están en la tabla. Vacío = acceso abierto.
LH_ACCESO=
# 1 = "Entrar como…" en Sumarte sin Privy. Solo Preview y Development: en Production el código lo ignora.
# Solo acepta emails que terminan en .test.
LH_AUTH_PRUEBA=

# Prueba de billeteras con Candide (billeteras-candide-prueba, /netx/billetera-prueba). Todo solo del servidor, sin NEXT_PUBLIC_.
# Solo Preview (solo la rama agente/billeteras-candide-prueba) y Development. En Production la carga Gus, no un agente.
# Las URL llevan la clave de Candide: son secretas. Proyecto de Candide solo de testnet (docs/guiones/billeteras-candide-prueba.md).
# 1 = la prueba existe (sin esto, la página y las rutas responden 404).
LH_PRUEBA_CANDIDE=
# 1 = modo simulado: no se habla con Candide ni con la red (e2e y para mirar la página sin clave).
LH_PRUEBA_CANDIDE_SIMULADO=
# Opcional: RPC de Base Sepolia (por defecto https://sepolia.base.org). Si es de pago lleva clave: también es secreto.
LH_PRUEBA_CANDIDE_RPC=
CANDIDE_BUNDLER_URL=
CANDIDE_PAYMASTER_URL=
# Opcional: id de la política de patrocinio del panel de Candide.
CANDIDE_SPONSORSHIP_POLICY_ID=
