{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git rev-parse*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(scripts/preview-url.sh*)",
      "Bash(scripts/curl-preview.sh*)",
      "Bash(./scripts/preview-url.sh*)",
      "Bash(./scripts/curl-preview.sh*)",
      "Bash(curl -s*)",
      "Bash(ls*)",
      "Bash(mkdir *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(date*)",
      "Bash(BASE_URL=* pnpm test:e2e*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(jq *)",
      "Bash(xargs cat*)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(test *)",
      "Bash(echo *)",
      "Bash(git merge *)",
      "Bash(git worktree list*)",
      "Bash(PORT=* pnpm *)",
      "Bash(BASE_URL=* PORT=* pnpm test:e2e*)",
      "Bash(git rm *)",
      "Bash(gh pr edit*)",
      "Bash(bash scripts/*)",
      "Bash(BASE_URL=* pnpm exec playwright *)",
      "Bash(pnpm exec playwright *)",
      "Bash(git ls-tree*)",
      "Bash(git check-ignore*)",
      "Bash(git merge-base*)",
      "Bash(scripts/nube-inicio.sh*)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(vercel *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guardia.mjs",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/nube-inicio.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
